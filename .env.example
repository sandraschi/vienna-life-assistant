# Vienna Life Assistant - Environment Configuration (copy to .env)
# Database
DATABASE_URL=postgresql://vla_user:YOUR_PASSWORD@postgres:5432/vienna_life
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-this-to-a-random-secret
ENVIRONMENT=development
# Microsoft Graph (Calendar Integration)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Plex Media Server
PLEX_URL=http://localhost:32400
PLEX_TOKEN=YOUR_PLEX_TOKEN_HERE
# Calibre
CALIBRE_URL=http://localhost:8083
# Immich (Photo Management)
IMMICH_URL=http://localhost:2283
IMMICH_API_KEY=YOUR_IMMICH_API_KEY_HERE
# Ollama (Local AI)
OLLAMA_MODEL=llama3.2:3b
# Tailscale/Network Configuration
TAILSCALE_HOSTNAME=
TAILSCALE_BACKEND_PORT=7334
TAILSCALE_FRONTEND_PORT=7333
# CORS
CORS_ORIGINS=http://localhost:7333,http://localhost:10988,http://localhost:10922

# AiWatcher (personal news engine, fleet server :10946)
AIWATCHER_URL=http://127.0.0.1:10946
AIWATCHER_TIMEOUT=8

# OneNote (via onenote-mcp gateway, fleet server :10907)
ONENOTE_MCP_URL=http://127.0.0.1:10907
ONENOTE_MCP_TIMEOUT=8

# Email (via email-mcp gateway, fleet server :10813)
EMAIL_MCP_URL=http://127.0.0.1:10813
EMAIL_MCP_USER=sandra
EMAIL_MCP_PASSWORD=vienna2026
EMAIL_MCP_TIMEOUT=10

# PA engine
PA_BRIEF_EMAIL=0
PA_BRIEF_RECIPIENT=
RAG_EMBED_MODEL=nomic-embed-text

# Fleet orchestration (ednaficator-style)
FLEET_MCP_ALLOWLIST=plex-mcp,calibre-mcp,gtfs-mcp,aiwatcher-mcp
DEVICES_MCP_URL=http://127.0.0.1:10717
